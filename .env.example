# ─────────────────────────────────────────────────────────────────────────────
# Unfolda — local development environment
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Matches the docker-compose db service defaults.
DATABASE_URL=postgresql+psycopg2://unfolda:unfolda@localhost:5432/unfolda

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication ───────────────────────────────────────────────────────────
# Secret used to verify JWTs issued by NextAuth.js.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me-use-openssl-rand-hex-32

# ── Object Storage (S3-compatible) ───────────────────────────────────────────
# For local dev, point at a local MinIO instance or leave blank to use
# FakeStorageClient (tests only).
S3_BUCKET_NAME=unfolda-local
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# ── Signed URL policy ────────────────────────────────────────────────────────
SIGNED_URL_MIN_EXPIRY_SECONDS=60
SIGNED_URL_MAX_EXPIRY_SECONDS=900
SIGNED_URL_BASE_URL=http://localhost:9000/unfolda-local

# ── User provisioning ────────────────────────────────────────────────────────
# Comma-separated Google email addresses granted is_admin=True on first login.
ADMIN_EMAILS=admin@example.com

# Initial credit balance granted to new users on registration.
INITIAL_CREDIT_GRANT=100

# ── Cost control ─────────────────────────────────────────────────────────────
COST_TOKENS_PER_WORD=1.5
COST_CONTEXT_OVERHEAD_RATIO=0.15
COST_GUIDED_MODE_PASSES=2
COST_OUTPUT_RATIO_TRANSLATE=1.2
COST_OUTPUT_RATIO_GUIDED=1.5
COST_USD_PER_1K_TOKENS_IN=0.0015
COST_USD_PER_1K_TOKENS_OUT=0.002
COST_MAX_USD_PER_JOB=5.00
COST_MAX_USD_PER_RETRY=1.00

# ── Retention ────────────────────────────────────────────────────────────────
# Days after a job reaches a terminal state before its content artifacts
# are deleted by the cleanup worker.
RETENTION_WINDOW_DAYS=30

# ── Language detection ───────────────────────────────────────────────────────
# Seed for langdetect determinism. Change only if testing different behavior.
LANGDETECT_SEED=42

# ── LLM provider (Anthropic) ─────────────────────────────────────────────────
# API key for Anthropic Claude. Required for the translation pipeline stage.
# Obtain from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for translation. Defaults to claude-haiku-4-5-20251001.
# Override to use a different model (must be in your account's allowlist).
TRANSLATION_MODEL=claude-haiku-4-5-20251001
